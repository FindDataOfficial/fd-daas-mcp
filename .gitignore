# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
*.db
!/daas.db
# SQLite WAL/journal sidecars + db backups (never track the multi-file db state)
*.db-shm
*.db-wal
*.db-journal
*.db.bak*

# Docs site build output (docs-site/) - never commit the generated static site
docs-site/site/

# Secrets / env files (keep .env.example templates tracked)
.env
.env.*
!.env.example
!.env.*.example

# Node / Next
node_modules/
.next/
out/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local-only project tooling (openspec specs)
openspec/

# Data artifacts
*.csv
!specs/**/*.csv

# dartlab pre-built parquet caches (auto-downloaded from HuggingFace on first call)
mcp/dartlab-mcp/data/

# cnreport-mcp downloaded-report cache (PDF + extracted text + outline)
mcp/cnreport-mcp/.cache/

# Stray SQLite from a :memory: URL misconfiguration
:memory:

# TypeScript incremental build cache
*.tsbuildinfo

# Logs
*.log

# Skill eval run-outputs (regenerable; keep evals/ fixtures + grade_run.py)
.claude/skills/**/iteration-*/

# daas.db pre-migration backups (local only)
daas.db.pre-*
