# Database URL for CKAN MCP
# SQLite (default): sqlite:///../daas.db
CKAN_DATABASE_URL=sqlite:///../daas.db

# CKAN portal URL (default: data.gov)
CKAN_PORTAL_URL=https://data.gov/api/3/

# HTTP/HTTPS proxy (optional)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
