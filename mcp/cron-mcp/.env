# Database URL (PostgreSQL, MySQL, or SQLite)
# SQLite (default): sqlite:///../daas.db
# PostgreSQL: postgresql://user:pass@host:5432/cron_mcp
# MySQL: mysql+pymysql://user:pass@host:3306/cron_mcp
CRON_MCP_DATABASE_URL=sqlite:///../daas.db

# HTTP/HTTPS proxy (optional)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
