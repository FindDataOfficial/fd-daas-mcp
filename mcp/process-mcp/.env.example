# process-mcp — per-MCP overrides only. Root .env holds the shared values.

# OpenAI-compatible LLM endpoint (shared across MCPs). Required for extraction.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Optional: named model registry as JSON.
# Each entry: {"model": "...", "vision": true|false, "base_url": "...", "api_key": "..."}
# Per-model base_url/api_key override the shared LLM_* above.
# When unset, a single "default" model is derived from LLM_MODEL / LLM_API_KEY / LLM_BASE_URL.
#
# Example:
# PROCESS_MODELS={"fast":{"model":"gpt-4o-mini"},"eyes":{"model":"gpt-4o","vision":true}}
PROCESS_MODELS=

# Shared database (set in root .env as DAAS_DATABASE_URL). process-mcp reads
# scraped source tables (scraw_<slug>) and writes process_rules / process_results.
