# Database URL (PostgreSQL, MySQL, or SQLite)
# SQLite (default): sqlite:///../daas.db
# PostgreSQL: postgresql://user:pass@host:5432/akshare
# MySQL: mysql+pymysql://user:pass@host:3306/akshare
AKSHARE_DATABASE_URL=sqlite:///../daas.db

# HTTP/HTTPS proxy for AKShare data fetching (optional)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
