# SEC EDGAR requires a descriptive User-Agent. EdgarTools reads EDGAR_IDENTITY
# in the form "Name email@domain" and parses it into the UA header.
# Set this in root .env (preferred) or here as an override.
EDGAR_IDENTITY=

# HTTP/HTTPS proxy for outbound SEC requests (optional)
# HTTP_PROXY=http://127.0.0.1:7892
# HTTPS_PROXY=http://127.0.0.1:7892
