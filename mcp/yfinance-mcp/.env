# Database URL (PostgreSQL, MySQL, or SQLite)
# Leave unset to use the harness default (yfinance-agent-harness metadata/registry.db)
# YFINANCE_DATABASE_URL=sqlite:///../daas.db

# HTTP/HTTPS proxy for yfinance (Yahoo Finance) requests (optional)
# yfinance's requests.Session has trust_env=True, so these are honored.
HTTP_PROXY=http://127.0.0.1:7892
HTTPS_PROXY=http://127.0.0.1:7892
