# dartlab: basic use is KEYLESS (pre-built dataset auto-downloads from HuggingFace).
# A DART API key (free, from https://opendart.fss.or.kr) is only needed for raw
# re-collection via dartlab.OpenDart() / `dartlab collect`. Set in root .env
# (preferred) or here as an override. Not required for the MCP tools below.
DART_API_KEY=

# HTTP/HTTPS proxy for outbound requests (optional)
# HTTP_PROXY=http://127.0.0.1:7892
# HTTPS_PROXY=http://127.0.0.1:7892
