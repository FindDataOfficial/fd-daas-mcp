# ── Database ─────────────────────────────────────────────────────
# Single database for all MCPs and the dashboard.
# Managed via dashboard /settings page — changes here require restart.
DAAS_DATABASE_URL=sqlite:///mcp/daas.db

# ── Proxy ────────────────────────────────────────────────────────
# HTTP/HTTPS proxy for outbound data requests.
# Managed via dashboard /settings page — changes take effect immediately.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ── Source-Specific ──────────────────────────────────────────────
# CKAN portal URL (mapped to CKAN_URL in settings table).
# Managed via dashboard /settings page.
CKAN_PORTAL_URL=https://data.gov/api/3/

# ── Dashboard ────────────────────────────────────────────────────
# Managed via dashboard /settings page — changes require restart.
DASHBOARD_PORT=4000

# ── LLM ──────────────────────────────────────────────────────────
# Used by trading-mcp (and future agent-based MCPs).
# Managed via dashboard /settings page — changes take effect immediately.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
#LLM_API_KEY=ark-e3597b3f-70aa-426f-9c95-19aee26872a0-ebdcf
LLM_API_KEY=ark-b10dcb9f-61f2-4074-beb5-4aac488cc581-00179
LLM_MODEL=deepseek-v4-pro-260425

# SEC EDGAR (edgartools-mcp) — descriptive User-Agent required by SEC
EDGAR_IDENTITY="scs001 finddataofficial@example.com"

# ── scrapling-uv-mcp script runner ────────────────────────────────
# Directory for reusable scraper scripts (default: mcp/scrapling-uv-mcp/scripts/scrapers/).
# run_script timeout in seconds (default 120).
# SCRAPLING_SCRIPTS_DIR=mcp/scrapling-uv-mcp/scripts/scrapers
# SCRAPLING_SCRIPT_TIMEOUT=120

# ── Dashboard chat ───────────────────────────────────────────────
# Provider used by /api/chat and /api/collections/[name]/chat.
# One of: anthropic, openai, google, openrouter, ollama, volcengine.
# CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# MCP server the dashboard chat connects to (for tool calls). Use daas-mcp
# so the collections chat can call fetch_data / list_sources / list_collection
# against the same database it edits.
# MCP_SERVER=daas-mcp
