# ── Proxy Configuration ─────────────────────────────────────────────
# HTTP/HTTPS proxy for outbound data requests
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ── Database URLs ──────────────────────────────────────────────────
# Default DAAS database (shared by all MCPs)
DAAS_DATABASE_URL=sqlite:///mcp/daas.db

# Per-MCP database overrides (optional, defaults to DAAS_DATABASE_URL)
# CKAN_DATABASE_URL=sqlite:///mcp/daas.db
# CNSTATS_DATABASE_URL=sqlite:///mcp/daas.db
# WORLDBANK_DATABASE_URL=sqlite:///mcp/daas.db
# AKSHARE_DATABASE_URL=sqlite:///mcp/daas.db

# ── Source-Specific Config ─────────────────────────────────────────
# CKAN portal URL
CKAN_PORTAL_URL=https://data.gov/api/3/
