{
  "source": {
    "name": "tiny_econ",
    "module": "tiny_econ.api",
    "label": "Tiny Econ (fixture)",
    "url": "https://api.example.com",
    "category": "macro_economics",
    "install": "pip install -e <path-to-tiny_econ>",
    "endpoint_unreachable": true,
    "analysis_method": "AST + docstring (no execution)"
  },
  "dispatch": [
    {
      "function": "get_cpi_series",
      "cli_command": "get-cpi-series",
      "module": "tiny_econ.api",
      "callable": "get_cpi_series",
      "call_shape": "get_cpi_series(country=<str>, start_year=<int>, end_year=<int>)",
      "return_type": "pandas.DataFrame",
      "frequency": "monthly",
      "parameters": [
        {"name": "country", "type": "string", "required": false, "default": "CN", "entity_ref": "country.alpha2"},
        {"name": "start_year", "type": "integer", "required": false, "default": 2010},
        {"name": "end_year", "type": "integer", "required": false, "default": 2024}
      ],
      "output_columns": [
        {"name": "date", "type": "string", "role": "date_key"},
        {"name": "cpi_yoy", "type": "float", "role": "metric"},
        {"name": "country", "type": "string", "role": "dimension"}
      ],
      "storage_table": "scraw_tiny_econ_cpi",
      "upsert_keys": ["date", "country"],
      "proposed_indicators": [
        {"indicator_name": "sma12_cpi_yoy", "op": "sma", "value_column": "cpi_yoy", "params": {"window": 12}},
        {"indicator_name": "pct_change_cpi_yoy", "op": "pct_change", "value_column": "cpi_yoy", "params": {}},
        {"indicator_name": "zscore12_cpi_yoy", "op": "zscore", "value_column": "cpi_yoy", "params": {"window": 12}}
      ]
    },
    {
      "function": "fetch_gdp_quarterly",
      "cli_command": "fetch-gdp-quarterly",
      "module": "tiny_econ.api",
      "callable": "fetch_gdp_quarterly",
      "call_shape": "fetch_gdp_quarterly(country=<str>)",
      "return_type": "pandas.DataFrame",
      "frequency": "quarterly",
      "parameters": [
        {"name": "country", "type": "string", "required": false, "default": "US", "entity_ref": "country.alpha2"}
      ],
      "output_columns": [
        {"name": "date", "type": "string", "role": "date_key"},
        {"name": "gdp_current_usd", "type": "float", "role": "metric"},
        {"name": "gdp_growth_yoy", "type": "float", "role": "metric"},
        {"name": "country", "type": "string", "role": "dimension"}
      ],
      "storage_table": "scraw_tiny_econ_gdp",
      "upsert_keys": ["date", "country"],
      "proposed_indicators": [
        {"indicator_name": "sma4_gdp_current_usd", "op": "sma", "value_column": "gdp_current_usd", "params": {"window": 4}},
        {"indicator_name": "pct_change_gdp_current_usd", "op": "pct_change", "value_column": "gdp_current_usd", "params": {}},
        {"indicator_name": "zscore4_gdp_current_usd", "op": "zscore", "value_column": "gdp_current_usd", "params": {"window": 4}},
        {"indicator_name": "sma4_gdp_growth_yoy", "op": "sma", "value_column": "gdp_growth_yoy", "params": {"window": 4}},
        {"indicator_name": "pct_change_gdp_growth_yoy", "op": "pct_change", "value_column": "gdp_growth_yoy", "params": {}},
        {"indicator_name": "zscore4_gdp_growth_yoy", "op": "zscore", "value_column": "gdp_growth_yoy", "params": {"window": 4}}
      ]
    },
    {
      "function": "list_countries",
      "cli_command": "list-countries",
      "module": "tiny_econ.api",
      "callable": "list_countries",
      "call_shape": "list_countries()",
      "return_type": "list_of_objects",
      "frequency": "irregular",
      "parameters": [],
      "output_columns": [
        {"name": "code", "type": "string", "role": "dimension"},
        {"name": "name", "type": "string", "role": "dimension"}
      ],
      "storage_table": "scraw_tiny_econ_countries",
      "upsert_keys": ["code"],
      "proposed_indicators": []
    },
    {
      "function": "fetch_holidays",
      "cli_command": "holidays",
      "module": "tiny_econ.api",
      "callable": "fetch_holidays",
      "call_shape": "fetch_holidays(market=<str>)",
      "return_type": "pandas.DataFrame",
      "frequency": "annual",
      "has_existing_cli": true,
      "cli_wrapped_by_sidecar": false,
      "parameters": [
        {"name": "market", "type": "string", "required": false, "default": "US", "entity_ref": "country.alpha2"}
      ],
      "output_columns": [
        {"name": "date", "type": "string", "role": "date_key"},
        {"name": "market", "type": "string", "role": "dimension"},
        {"name": "name", "type": "string", "role": "dimension"}
      ],
      "storage_table": "scraw_tiny_econ_holidays",
      "upsert_keys": ["date", "market"],
      "proposed_indicators": []
    }
  ],
  "excluded": [
    {"name": "_normalize", "reason": "private helper, not a data fetcher"}
  ]
}
