# Override DAAS_DATABASE_URL for testing (root .env is loaded first)
# DAAS_DATABASE_URL=sqlite:///:memory:

# LEADER_MODELS — per-agent LLM registry for crewai-data-workflow specialist
# agents (mirrors daas-mcp's PROCESS_MODELS). JSON: {name: {model, base_url?,
# api_key?, provider?, vision?}}. Per-model fields fall back to the shared
# LLM_BASE_URL / LLM_API_KEY / LLM_MODEL from the root .env. Unset → a single
# "default" model from the shared LLM_* env (so specialist agents work with no
# extra config). Bind an agent to a named model via create_specialist_agent(model=...).
# Example:
# LEADER_MODELS={"fast":{"model":"gpt-4o-mini"},"strong":{"model":"o3","provider":"openai"}}

