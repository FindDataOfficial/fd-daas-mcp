# ──────────────────────────────────────────────────────────────────────────
# fd-daas-mcp environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit
# real secrets. Every value below is a placeholder - replace with your own.
# ──────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────
# Single database for every tool group (entities, indicators, observations,
# dashboards, collections, rules, alerts, cron, leader, pdf, research).
# Default: a `daas.db` SQLite file in the working directory.
DAAS_DATABASE_URL=sqlite:///daas.db
# Optional per-group overrides (default to DAAS_DATABASE_URL):
# DAAS_REGISTRY_DB=
# LEADER_MCP_DATABASE_URL=

# ── Proxy ─────────────────────────────────────────────────────────────────
# Outbound HTTP/HTTPS proxy for data requests. Leave commented if direct.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── LLM (powers the leader group's CrewAI DataCrew + specialist agents) ───
# One of: an OpenAI-compatible endpoint (LLM_*) or OpenAI directly (OPENAI_*).
# LLM_API_KEY=<your-llm-api-key>
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=<your-model-name>
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL=gpt-4o-mini

# Leader model tiers (entries in LEADER_MODELS; each tier resolves to one model).
# LEADER_MODELS=
# LEADER_MODEL_HIGH=
# LEADER_MODEL_BALANCE=
# LEADER_MODEL_FAST=

# ── Source-specific ───────────────────────────────────────────────────────
# SEC EDGAR requires a User-Agent identifying your app + email.
# EDGAR_IDENTITY=Sample App admin@example.com
# Japanese EDINET filings API.
# EDINET_API_KEY=<your-edinet-api-key>
# CKAN portal URL (mapped to CKAN_URL in the settings table).
# CKAN_PORTAL_URL=https://catalog.data.gov
# Set AKSHARE_LIVE=1 to enable live A-share fetches (requires the `akshare` extra).
# AKSHARE_LIVE=1

# ── LLM extraction (daas process tools) ───────────────────────────────────
# PROCESS_MODELS selects the LLM used by extract_text/extract_file/extract_image
# and the `llm` rule type. Same format as LEADER_MODELS entries. Leave unset to
# disable LLM extraction (the tools then error per-call, not at startup).
# PROCESS_MODELS=high

# ── Composite + pipeline ──────────────────────────────────────────────────
# COMPOSITE selects which saved composite config to load at server startup
# (see composite_save_example). Leave unset to start with no composite active.
# COMPOSITE=
# MCP_JSON_PATH overrides where pipeline_tools looks for .mcp.json when wiring
# fetch+cron pipeline items. Defaults to <repo-root>/.mcp.json.
# MCP_JSON_PATH=.mcp.json

# ── Alerts ────────────────────────────────────────────────────────────────
# Configure only the channels you use; unconfigured channels are skipped.
# ALERTS_FEISHU_WEBHOOK_URL=<https://open.feishu.cn/open-apis/bot/v2/hook/...>
# ALERTS_FEISHU_SECRET=<optional-signing-secret>
# ALERTS_DINGTALK_WEBHOOK_URL=<https://oapi.dingtalk.com/robot/send?access_token=...>
# ALERTS_DINGTALK_SECRET=<optional-signing-secret>
# ALERTS_DISCORD_WEBHOOK_URL=<https://discord.com/api/webhooks/...>
# ALERTS_SLACK_WEBHOOK_URL=<https://hooks.slack.com/services/...>
# ALERTS_TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
# ALERTS_TELEGRAM_CHAT_ID=<your-chat-id>
# ALERTS_WECOM_WEBHOOK_URL=<https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...>
# ALERTS_TWITTER_CONSUMER_KEY=
# ALERTS_TWITTER_CONSUMER_SECRET=
# ALERTS_TWITTER_ACCESS_TOKEN=
# ALERTS_TWITTER_ACCESS_TOKEN_SECRET=

# ── Dashboard ─────────────────────────────────────────────────────────────
# Port for the standalone HTML dashboard registry server.
# DASHBOARD_PORT=4000

# ── PDF (optional `pdf` extra: local vector search) ───────────────────────
# PDF_EMBEDDING_BACKEND=sentence-transformers
# PDF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Cron ──────────────────────────────────────────────────────────────────
# Timezone for cron schedules (defaults to UTC).
# CRON_TIMEZONE=UTC

# ── Research ──────────────────────────────────────────────────────────────
# Directory where research bundles + generated markdown reports are written.
# RESEARCH_DIR=./researches
