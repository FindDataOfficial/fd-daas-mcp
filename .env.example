# DAAS environment variables. Copy to `.env` and fill in the keys you need.
# Scripts and the fd-daas-mcp server auto-load repo-root `.env`. All keys are
# OPTIONAL unless you use the feature they gate.

# Database URL. Optional - unset, defaults to ./daas.db (writable cwd) or
# ~/.fd-daas-mcp/daas.db. Set to relocate (e.g. a shared/absolute path).
# Run `fd-daas-mcp init` to provision + seed; `fd-daas-mcp doctor` to inspect.
DAAS_DATABASE_URL=sqlite:///daas.db

# Outbound proxy for data libraries (akshare/yfinance/etc. egress).
# HTTP_PROXY=http://127.0.0.1:7892

# SEC EDGAR identity string ("Name email@domain") - required for edgar fetches.
# EDGAR_IDENTITY=

# Japan EDINET document fetch key - required for edinet fetches.
# EDINET_API_KEY=

# Shared LLM endpoint for extraction / leader fallback.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Per-tier model overrides for leader-mcp.
# LEADER_MODELS=
# LEADER_MODEL_HIGH=
# LEADER_MODEL_BALANCE=
# LEADER_MODEL_FAST=

# Feishu webhook for the alerts channel.
# ALERTS_FEISHU_WEBHOOK_URL=

# Port for the dashboard app.
# DASHBOARD_PORT=

# CKAN portal base URL.
# CKAN_PORTAL_URL=

# ── Skill-specific external paths / credentials ──────────────────
# Machine-specific locations + server credentials referenced by skills.
# Set the ones for the skills you use.

# fd-datasource-akshare: path to the scraw-akshare project + its PostgreSQL URL.
# SCRAW_AKSHARE_DIR=
# ASTOCK_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finddata

# fd-coding-daas-update: path to the public fd-daas-mcp package repo (release
# target). Defaults to ~/code/fd-daas-mcp-public/ if unset; --public-repo overrides.
# FD_DAAS_MCP_PUBLIC_REPO=

# fd-coding-daas-update: PyPI upload token. Prefer .env here; ~/.zshrc is a
# fallback. Never passed as a CLI arg.
# PYPI_API_KEY=
